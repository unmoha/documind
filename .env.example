# ==============================================================================
# DocuMind Environment Configuration
# Copy this file to .env and adjust values for your local development setup.
# ==============================================================================

# Application & Environment
DOCUMIND_ENV=development
DOCUMIND_LOG_LEVEL=INFO
DOCUMIND_API_HOST=0.0.0.0
DOCUMIND_API_PORT=8000
DOCUMIND_STREAMLIT_PORT=8501

# Storage Paths (relative to project root or absolute paths)
DOCUMIND_CHROMA_PERSIST_DIR=./chroma_db
DOCUMIND_SQLITE_DB_PATH=./logs.sqlite

# Ingestion & Chunking
DOCUMIND_CHUNK_SIZE=800
DOCUMIND_CHUNK_OVERLAP=120

# Embedding Model (BAAI/bge-small-en-v1.5 runs locally via sentence-transformers)
DOCUMIND_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCUMIND_EMBEDDING_DEVICE=cpu

# Retrieval Configuration
DOCUMIND_TOP_K=4
DOCUMIND_SIMILARITY_THRESHOLD=0.5

# LLM Provider Configuration
# Supported providers: "gemini" (default), "groq"
DOCUMIND_LLM_PROVIDER=gemini
DOCUMIND_LLM_MODEL=gemini-3.8-flash
DOCUMIND_TEMPERATURE=0.0
DOCUMIND_REQUEST_TIMEOUT_SECONDS=30.0
DOCUMIND_MAX_RETRIES=3

# API Keys (Keep these secret! Never commit real keys)
DOCUMIND_GEMINI_API_KEY=
DOCUMIND_GROQ_API_KEY=
